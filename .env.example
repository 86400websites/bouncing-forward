# Bouncing Forward — environment template (names + placeholders only; never real values)
# Copy to .env.local for local dev. .env.local is gitignored and never committed.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — in use from day one (assessment result storage)
# Use the NON-PRODUCTION project's values locally.
NEXT_PUBLIC_SUPABASE_URL=https://[SUPABASE_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=          # sb_publishable_... — browser-safe
# SUPABASE_SECRET_KEY=                         # sb_secret_... — NOT provisioned; add only if a trusted server path ever needs RLS bypass

# Mailchimp (marketing email + lead magnet + assessment tags) — server-only
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Transactional email (Share Your Story / contact delivery) — server-only
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@[PRODUCTION_DOMAIN]
RESEND_TO_EMAIL=

# Anti-abuse (recommended in Production; no-op locally when blank)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=                      # server-only
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=                          # server-only

# Optional analytics / error tracking (no-op when blank)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                             # server/build-time only
SENTRY_ORG=
SENTRY_PROJECT=

# Reserved for the course phase — DO NOT provision in phase 1
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
